{
  "name": "cc-session-manager",
  "version": "0.0.0",
  "private": true,
  "description": "Manage and monitor Claude Code sessions",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cc-session-manager": "dist/server/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/cli.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.1",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  }
}
