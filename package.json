{
  "name": "cc-session-manager",
  "version": "0.5.0",
  "private": true,
  "description": "Manage and monitor Claude Code sessions",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cc-session-manager": "dist/server/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/cli.js",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/node-ws": "^1.3.1",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  }
}
